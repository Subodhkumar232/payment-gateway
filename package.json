{
  "name": "youpi-pg",
  "version": "1.0.0",
  "type": "module",
  "description": "Self-Hosted White-Label UPI Payment Gateway with Payment Observation Engine",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.js",
    "db:setup": "node scripts/init-db.cjs",
    "sync:package": "node scripts/sync-package.cjs",
    "start": "node scripts/start.js",
    "start:prod": "node scripts/start.js",
    "start:prod:api": "node apps/payment-api/src/index.js",
    "dev": "node scripts/dev.js",
    "test": "node scripts/test-all.js",
    "test:all": "node scripts/test-all.js",
    "test:acceptance": "node --test scripts/production-infrastructure.test.js",
    "build:android:apk": "node scripts/build-android-apk.js",
    "sync:android-allowlist": "node scripts/sync-android-allowlist.js",
    "build:admin:jsx": "node apps/merchant-admin/scripts/build-jsx.js",
    "build:admin:css": "./node_modules/.bin/tailwindcss -c ./apps/merchant-admin/tailwind.config.js -i ./apps/merchant-admin/src/styles/input.css -o ./apps/merchant-admin/public/css/admin.css --minify",
    "build:admin": "npm run build:admin:jsx && npm run build:admin:css",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "braces": "^3.0.3"
  },
  "author": "Antigravity Systems",
  "license": "Commercial"
}
